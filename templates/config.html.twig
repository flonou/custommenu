{% extends "generic_show_form.html.twig" %}

{% block content %}
<div class="c-block">
    <div class="c-block__head">
        <h2 class="c-block__title">{{ __('Custom menu entries', 'custommenu') }}</h2>
    </div>
    <div class="c-block__body">
        <p>
            {{ __('Manage the custom entries displayed in the main GLPI menu.', 'custommenu') }}
        </p>
        <p>
            <a class="btn btn-primary" href="{{ 'GlpiPlugin\\CustomMenu\\CustomMenu'|itemtype_form_path }}">
                <i class="ti ti-plus"></i>
                <span>{{ _x('button', 'Add') }}</span>
            </a>
            <a class="btn btn-secondary" href="{{ 'GlpiPlugin\\CustomMenu\\CustomMenu'|itemtype_search_path }}">
                <i class="ti ti-list"></i>
                <span>{{ _x('button', 'List') }}</span>
            </a>
        </p>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{ __('Name') }}</th>
                    <th>{{ __('URL') }}</th>
                    <th>{{ __('Icon') }}</th>
                    <th>{{ __('Position') }}</th>
                    <th>{{ __('Target') }}</th>
                    <th>{{ __('Active') }}</th>
                    <th>{{ _x('button', 'Actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                <tr>
                    <td>{{ entry.name }}</td>
                    <td><a href="{{ entry.url }}" target="_blank">{{ entry.url }}</a></td>
                    <td><i class="{{ entry.icon }}"></i> <code>{{ entry.icon }}</code></td>
                    <td><code>{{ entry.position }}</code></td>
                    <td>{{ entry.target }}</td>
                    <td>
                        {% if entry.is_active %}
                            <span class="badge bg-success">{{ __('Yes') }}</span>
                        {% else %}
                            <span class="badge bg-danger">{{ __('No') }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="{{ 'GlpiPlugin\\CustomMenu\\CustomMenu'|itemtype_form_path }}?id={{ entry.id }}">
                            <i class="ti ti-edit"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center">{{ __('No custom menu entry defined.', 'custommenu') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
